# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Model paths (relative to project root, defaults used if not set)
CLASSICAL_MODEL_PATH=models/classical_model.pkl
TFIDF_VECTORIZER_PATH=models/tfidf_vectorizer.pkl
TRANSFORMER_MODEL_PATH=models/transformer_model

# Training configuration (used by src/train_transformer.py)
TRAIN_BATCH_SIZE=16
TRAIN_LEARNING_RATE=2e-5
TRAIN_EPOCHS=3
